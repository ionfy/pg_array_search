SELECT array_partition(ARRAY[1, 3, 2, 3, 4], 'x > 2');
   array_partition    
----------------------
 {{3,3,4},{1,2,NULL}}
(1 row)

SELECT array_partition(ARRAY[1, 3, 2, 3, 4], 'x >= 2');
        array_partition         
--------------------------------
 {{3,2,3,4},{1,NULL,NULL,NULL}}
(1 row)

SELECT array_partition(ARRAY[1, 3, 2, 3, 4], 'x < 3');
   array_partition    
----------------------
 {{1,2,NULL},{3,3,4}}
(1 row)

SELECT array_partition(ARRAY[1, 3, 2, 3, 4], 'x <= 3');
        array_partition         
--------------------------------
 {{1,3,2,3},{4,NULL,NULL,NULL}}
(1 row)

SELECT array_partition(ARRAY[1, 3, 2, 3, 4], 'x == 3');
   array_partition    
----------------------
 {{3,3,NULL},{1,2,4}}
(1 row)

SELECT array_partition(ARRAY[1, 3, 2, 3, 4], 'x != 3');
   array_partition    
----------------------
 {{1,2,4},{3,3,NULL}}
(1 row)

SELECT array_partition(ARRAY[1, 3, 2, 3, 4], 'x % 3 = 1');
   array_partition    
----------------------
 {{1,4,NULL},{3,2,3}}
(1 row)

SELECT array_partition(ARRAY[1, 3, 2, 3, 4], 'x % 10 = 8');
             array_partition              
------------------------------------------
 {{NULL,NULL,NULL,NULL,NULL},{1,3,2,3,4}}
(1 row)

SELECT array_partition(ARRAY[1, 3, 2, 3, 4], 'x > 12');
             array_partition              
------------------------------------------
 {{NULL,NULL,NULL,NULL,NULL},{1,3,2,3,4}}
(1 row)

SELECT array_partition(ARRAY['foo', 'bar', 'baz'], 'x == "foo"');
    array_partition     
------------------------
 {{foo,NULL},{bar,baz}}
(1 row)

SELECT array_partition(ARRAY['foo', 'bar', 'baz'], 'x != "foo"');
    array_partition     
------------------------
 {{bar,baz},{foo,NULL}}
(1 row)

SELECT array_partition(ARRAY['foo', 'bar', 'baz'], 'x == "foobar"');
         array_partition          
----------------------------------
 {{NULL,NULL,NULL},{foo,bar,baz}}
(1 row)

SELECT array_partition(ARRAY[[1, 3], [3, 4]], 'x > 2');
ERROR:  multidimensional arrays is not supported
SELECT array_partition(ARRAY[1, NULL, 2, NULL, 3, 4], 'x > 2');
 array_partition 
-----------------
 {{3,4},{1,2}}
(1 row)

SELECT array_partition(ARRAY[]::integer[], 'x % 3 = 1');
 array_partition 
-----------------
 {}
(1 row)

SELECT array_partition(NULL::integer[], 'x % 3 = 1');
 array_partition 
-----------------
 
(1 row)

SELECT array_partition(ARRAY[1, 2, 3], NULL);
 array_partition 
-----------------
 
(1 row)

SELECT array_partition(NULL::integer[], NULL);
 array_partition 
-----------------
 
(1 row)

SELECT array_partition(array_fill(1::int, ARRAY[67108864]), 'x = 1');
